{
    // ── Editor ────────────────────────────────────────────────────────────────
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "editor.detectIndentation": true,
    "editor.renderWhitespace": "none",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.suggestSelection": "first",
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "editor.wordBasedSuggestions": "off",

    // ── Terminal ──────────────────────────────────────────────────────────────
    "terminal.integrated.fontFamily": "Meslo LG M DZ for Powerline",
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
        "zsh": { "path": "/usr/bin/zsh" }
    },

    // ── Workbench ─────────────────────────────────────────────────────────────
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.colorTheme": "One Dark Pro",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.startupEditor": "newUntitledFile",

    // ── Files ─────────────────────────────────────────────────────────────────
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 5000,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.eol": "\n",
    "files.exclude": {
        "**/.classpath": true,
        "**/.factorypath": true,
        "**/.project": true,
        "**/.pytest_cache": true,
        "**/.settings": true
    },

    // ── Git ───────────────────────────────────────────────────────────────────
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.suggestSmartCommit": false,
    "git.enableSmartCommit": true,

    // ── Python ────────────────────────────────────────────────────────────────
    "python.languageServer": "Pylance",
    "python.autoComplete.addBrackets": true,
    "python.autoComplete.extraPaths": ["./", "./src", "./source"],
    "python.analysis.extraPaths": ["source"],
    "python.analysis.completeFunctionParens": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },

    // ── C/C++ ─────────────────────────────────────────────────────────────────
    "C_Cpp.updateChannel": "Insiders",
    "C_Cpp.default.intelliSenseMode": "clang-x64",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 0}",
    "C_Cpp.clang_format_sortIncludes": true,
    "C_Cpp.formatting": "vcFormat",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.function": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.lambda": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.block": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.namespace": "sameLine",
    "C_Cpp.vcFormat.newLine.beforeOpenBrace.type": "sameLine",

    // ── JavaScript ────────────────────────────────────────────────────────────
    "javascript.updateImportsOnFileMove.enabled": "always",
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // ── Markdown ──────────────────────────────────────────────────────────────
    "markdownlint.config": {
        "no-duplicate-header": false,
        "single-h1": false
    },
    "[markdown]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 100
    },

    // ── Explorer ──────────────────────────────────────────────────────────────
    "explorer.sortOrder": "type",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "breadcrumbs.enabled": true,

    // ── Extensions ────────────────────────────────────────────────────────────
    "extensions.ignoreRecommendations": false,
    "telemetry.telemetryLevel": "off",
    "gitlens.hovers.avatars": false,
    "gitlens.codeLens.enabled": false,
    "code-runner.runInTerminal": true,
    "code-runner.saveAllFilesBeforeRun": true,
    "code-runner.saveFileBeforeRun": true,
    "debug.showBreakpointsInOverviewRuler": true,
    "diffEditor.ignoreTrimWhitespace": false,

    // ── cSpell ────────────────────────────────────────────────────────────────
    "cSpell.languageSettings": [
        {
            "languageId": "python",
            "includeRegExpList": ["/#.*/", "/('''|\"\"\")[^\\1]+?\\1/g"]
        },
        { "languageId": "javascript", "includeRegExpList": ["CStyleComment"] },
        { "languageId": "c", "includeRegExpList": ["CStyleComment"] },
        { "languageId": "cpp", "includeRegExpList": ["CStyleComment"] }
    ],
    "cSpell.userWords": ["Utalizes", "evals", "numpy", "pylint"],

    // ── TODO Highlight ────────────────────────────────────────────────────────
    "todohighlight.isCaseSensitive": false,
    "todohighlight.keywords": [
        {
            "text": "NOTE:",
            "color": "#ffffff",
            "backgroundColor": "blue",
            "overviewRulerColor": "grey"
        },
        {
            "text": "REVIEW:",
            "color": "#ffffff",
            "backgroundColor": "green",
            "overviewRulerColor": "grey"
        }
    ],

    "window.zoomLevel": 0
}
