[includeIf "gitdir/i:*"]
    path = ~/.gitconfig-windows

[includeIf "gitdir/i:/"]
    path = ~/.gitconfig-wsl

[core]
    excludesfile = ~/.config/git/ignore
    ignoreCase = true
    safecrlf = false
    whitespace = -trailing-space
	fileMode = false
	autocrlf = input
    #eol = lf
    #editor = code --wait
	longpaths = true
[user]
    name = Jordan Sosnowski
    email = jordan.sosnowski@pnnl.gov
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIG7453USdRN6KA1yvlPFXKY0xWSM2D8o/lJsb2uMXB9+
[color]
    ui = auto
[pull]
    rebase = false
[gpg]
	format = ssh
[commit]
	gpgsign = true
[include]
    path = ~/.config/git/aliases

[hub]
    protocol = ssh
[init]
	defaultBranch = main
[gpg "ssh"]
	allowedSignersFile = /home/sosn071/.ssh/allowed_signers
[push]
	autoSetupRemote = true
