[includeIf "gitdir/i:*"]
    path = ~/.gitconfig-windows

[includeIf "gitdir/i:/"]
    path = ~/.gitconfig-wsl

[core]
    excludesfile = ~/.config/git/ignore
    ignoreCase = true
    safecrlf = false
    whitespace = -trailing-space
	fileMode = false
	autocrlf = input
    #eol = lf
    #editor = code --wait
	longpaths = true
[user]
    name = Jordan Sosnowski
    email = nadrojisk@pm.me
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP0Nw3yTljK1dyl2NE3QsvMGEtmAI0Mc634OucVzQYRR
[color]
    ui = auto
[pull]
    rebase = false
[gpg]
	format = ssh
[commit]
	gpgsign = true
[include]
    path = ~/.config/git/aliases

[hub]
    protocol = ssh
[init]
	defaultBranch = main
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[push]
	autoSetupRemote = true
