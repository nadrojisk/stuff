[core]
    excludesfile = ~/.config/git/ignore
    safecrlf = false
    whitespace = -trailing-space
	autocrlf = input
    #eol = lf
    #editor = code --wait
[user]
    name = Jordan Sosnowski
    email = nadrojisk@pm.me
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP0Nw3yTljK1dyl2NE3QsvMGEtmAI0Mc634OucVzQYRR
[color]
    ui = auto
[pull]
    rebase = false
[gpg]
	format = ssh
[commit]
	gpgsign = true
[include]
    path = ~/.config/git/aliases

[hub]
    protocol = ssh
[init]
	defaultBranch = main
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[push]
	autoSetupRemote = true

# Platform settings live in their own files. `make install` links only the one for this machine, git skips missing includes, and
# native Windows links ~/.gitconfig-windows by hand (see README). After the settings above, so a platform file can override them.
[include]
    path = ~/.gitconfig-windows
    path = ~/.gitconfig-wsl
    path = ~/.gitconfig-macos

# Machine-specific settings (credential helpers, ...) that don't belong in the repo. Last, so it wins.
[include]
    path = ~/.gitconfig.local
